# Copy to .env.production (project root, next to docker-compose.prod.yml)
# and fill in real values. This one file serves two purposes: Docker
# Compose reads it directly for ${VARS} used in docker-compose.prod.yml
# (DOMAIN, POSTGRES_*, ...) when you pass --env-file .env.production, and
# the backend/backup containers also load it via env_file: for their own
# runtime settings (DJANGO_SECRET_KEY, SENTRY_DSN, ...).
#
# Never commit the filled-in file - it's covered by the repo's .gitignore
# (`.env` matches `.env.production` too), but double check before you ever
# `git add` anything in here.

# --- Domain & TLS (Caddy) ---
DOMAIN=school.example.com
CADDY_ACME_EMAIL=you@example.com

# --- Django ---
# Generate with: docker compose -f docker-compose.prod.yml run --rm backend \
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
# Must match DOMAIN above (no https://, no trailing slash).
DJANGO_ALLOWED_HOSTS=school.example.com
# Must match DOMAIN above, with https://.
CORS_ALLOWED_ORIGINS=https://school.example.com

# --- Database ---
# Generate a strong password: openssl rand -base64 32
POSTGRES_NAME=school_db
POSTGRES_USER=school_app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1

# --- Backups ---
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Error tracking (optional but recommended) ---
# Leave blank to disable Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- File storage (optional) ---
# Leave AWS_STORAGE_BUCKET_NAME blank to keep local-disk storage (fine for a
# single-server deployment as long as the media_data volume is backed up).
# Works with AWS S3 or any S3-compatible provider (DigitalOcean Spaces,
# Cloudflare R2, MinIO) - set AWS_S3_ENDPOINT_URL for non-AWS providers.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
